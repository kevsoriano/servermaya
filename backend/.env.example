ALLOWLIST_EMAIL=you@example.com,teammate@example.com
MESSENGER_PAGE_ID=
MESSENGER_PAGE_TOKEN=
# Optional: the Messenger webhook, so a tap on Confirm or Received applies at once. App secret from the Meta app's Basic
# settings; the verify token is any random string, entered in the Meta app's webhook settings too.
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
# Optional: 1 only once Meta has granted the Human Agent permission; sellers may then reply up to 7 days after the customer
MESSENGER_HUMAN_AGENT=
GEMINI_MODEL=gemini-3.8-flash
# from `make memory-bank`; empty turns off the claim reviewer's memory of past decisions
MEMORY_BANK=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
