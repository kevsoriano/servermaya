ALLOWLIST_EMAIL=you@example.com,teammate@example.com
MESSENGER_PAGE_ID=
MESSENGER_PAGE_TOKEN=
# Optional: the Messenger webhook, so a tap on Confirm or Received applies at once. App secret from the Meta app's Basic
# settings; the verify token is any random string, entered in the Meta app's webhook settings too.
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
# Optional: 1 only once Meta has granted the Human Agent permission; sellers may then reply up to 7 days after the customer
MESSENGER_HUMAN_AGENT=
# Optional: Google Maps. Server key restricted to the Geocoding API; browser key restricted to the Maps JavaScript API and
# this app's addresses (it is public). Empty: delivery pins are pasted by hand.
MAPS_SERVER_KEY=
MAPS_BROWSER_KEY=
# The Map ID from Google Maps Platform > Map Management (not secret); empty uses Google's DEMO_MAP_ID
MAPS_MAP_ID=
GEMINI_MODEL=gemini-3.8-flash
# the demo's AI customer
GEMINI_DEMO_MODEL=gemini-3.5-flash-lite
# from `make memory-bank`; empty turns off the claim reviewer's memory of past decisions
MEMORY_BANK=
# Optional: the Model Armor template that screens customer messages and receipt screenshots; empty turns it off
MODEL_ARMOR_TEMPLATE=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
MODEL_ARMOR_TEMPLATE=